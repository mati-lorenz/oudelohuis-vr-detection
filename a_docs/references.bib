@online{nuiten2026Baseline,
  title = {Baseline Activity of {{V1}} Interneurons Connects Pupil-Linked Arousal to Engaged Behavioral State},
  author = {Nuiten, S. A. and Lohuis, M. N. Oude and Schaub, A. C. and family=Gaal, given=S., prefix=van, useprefix=false and Olcese, U. and Pennartz, C. M. A. and Sterzer, P. and family=Gee, given=J. W., prefix=de, useprefix=false},
  date = {2026-03-11},
  eprinttype = {bioRxiv},
  eprintclass = {New Results},
  pages = {2026.02.05.704022},
  issn = {2692-8205},
  doi = {10.64898/2026.02.05.704022},
  url = {https://www.biorxiv.org/content/10.64898/2026.02.05.704022v2},
  urldate = {2026-08-19},
  abstract = {Humans and rodents alternate between discrete, persistent behavioral states during perceptual decision-making. For example, trials can be clustered into states of engaged, disengaged, and biased decision-making strategies. In mice, the probability of being in an engaged state exhibits an inverted-U relationship with baseline pupil-linked arousal, consistent with the Yerkes-Dodson Law. We replicated this relationship in mice (N=11; audio-visual change detection task) and showed that it generalizes to humans (N=69; auditory detection task). We then examined its neural basis, using simultaneous pupillometry and electrophysiological recordings in mouse V1. A nonlinear mediation model revealed that baseline activity of putative fast-spiking interneurons, but not putative pyramidal neurons, made a significant statistical contribution to the inverted-U shaped relationship between pupil-linked arousal and engaged-state probability. These findings are consistent with the idea that arousal may shape behavioral states by modulating baseline inhibitory activity within a primary sensory region.},
  langid = {english},
  pubstate = {prepublished},
  file = {/u/g/glorenz/Zotero/storage/732EY8ES/Nuiten et al. - 2026 - Baseline activity of V1 interneurons connects pupil-linked arousal to engaged behavioral state.pdf;/u/g/glorenz/Zotero/storage/IYRWJRJJ/Nuiten et al. - 2026 - Baseline activity of V1 interneurons connects pupil-linked arousal to engaged behavioral state.pdf}
}

