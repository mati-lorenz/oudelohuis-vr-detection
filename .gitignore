# Byte-compiled / optimized / DLL files
__pycache__/
__pycache__
*.py[cod]
*.pyc
*.pyo

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Data
0_data/

# 2_pipeline/ is ignored by default (store/ caches and out/ tables can be
# large and are fully regenerable by re-running the scripts) EXCEPT the
# figure PNGs under each script's out/figures/, which the b_progress/*.md
# reports embed directly -- git won't apply a later `!` re-inclusion to
# anything whose parent directory was already excluded by an earlier
# pattern, so each directory level has to be re-included explicitly
# before the files inside it can be:
2_pipeline/*
!2_pipeline/*/
2_pipeline/*/*
!2_pipeline/*/out/
2_pipeline/*/out/*
!2_pipeline/*/out/figures/
2_pipeline/*/out/figures/*
!2_pipeline/*/out/figures/*.png
